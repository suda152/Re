{
  "name": "yice-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "build": "node tools/build-www.mjs && cap sync android",
    "build:web": "node tools/build-www.mjs",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "apk": "call android\\build-apk.bat",
    "samples": "python tools/make-samples.py",
